# Copy this file to .env and fill in from Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=https://your-project.supabase.co
# The publishable (or "anon public") key, never the secret / service_role key
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key

# Optional: your own domain, for the Facebook link preview (Vercel's address is filled in automatically)
# SITE_URL=https://www.your-domain.com
